generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                   String   @id
  productKey           String   @unique @map("product_key")
  name                 String
  description          String
  framework            String
  reportFormat         String   @map("report_format")
  freshnessTargetHours Int      @map("freshness_target_hours")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @map("updated_at")
  executions           TestExecution[]
  tokens               IntegrationToken[]

  @@map("products")
}

model TestExecution {
  id                  String   @id
  productId           String   @map("product_id")
  product             Product  @relation(fields: [productId], references: [id])
  baseKey             String   @unique @map("base_key")
  identityKey         String   @unique @map("identity_key")
  contentHash         String   @map("content_hash")
  reportFormat        String   @map("report_format")
  source              String
  origin              String
  suiteType           String   @map("suite_type")
  status              String
  total               Int
  executed            Int
  passed              Int
  failed              Int
  skipped             Int
  errors              Int
  durationMs          Int      @map("duration_ms")
  approvalRate        Float?   @map("approval_rate")
  qualityScore        Float?   @map("quality_score")
  infrastructureError Json?    @map("infrastructure_error")
  artifactPath        String?  @map("artifact_path")
  regressionDelta     Json     @map("regression_delta")
  startedAt           DateTime @map("started_at")
  finishedAt          DateTime @map("finished_at")
  createdAt           DateTime @default(now()) @map("created_at")
  pipeline            PipelineMetadata?
  suites              TestSuite[]
  demoRun             DemoRun?

  @@map("test_executions")
}

model PipelineMetadata {
  id          String        @id
  executionId String        @unique @map("execution_id")
  execution   TestExecution @relation(fields: [executionId], references: [id])
  branch      String
  commitSha   String        @map("commit_sha")
  pipelineId  String?       @map("pipeline_id")
  pipelineUrl String?       @map("pipeline_url")
  jobId       String?       @map("job_id")
  jobName     String        @map("job_name")
  jobUrl      String?       @map("job_url")
  artifactUrl String?       @map("artifact_url")
  environment String

  @@map("pipeline_metadata")
}

model TestSuite {
  id          String           @id
  executionId String           @map("execution_id")
  execution   TestExecution    @relation(fields: [executionId], references: [id])
  name        String
  status      String
  total       Int
  executed    Int
  passed      Int
  failed      Int
  skipped     Int
  errors      Int
  position    Int
  tests       TestCaseResult[]

  @@map("test_suites")
}

model TestCaseResult {
  id             String    @id
  suiteId        String    @map("suite_id")
  suite          TestSuite @relation(fields: [suiteId], references: [id])
  stableKey      String    @map("stable_key")
  framework      String
  filePath       String    @map("file_path")
  suitePath      Json      @map("suite_path")
  title          String
  status         String
  durationMs     Int       @map("duration_ms")
  errorType      String?   @map("error_type")
  errorMessage   String?   @map("error_message")
  expectedValue  String?   @map("expected_value")
  actualValue    String?   @map("actual_value")
  sanitizedStack String?   @map("sanitized_stack")
  position       Int

  @@map("test_case_results")
}

model IntegrationToken {
  id            String   @id
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id])
  tokenPrefix   String   @map("token_prefix")
  tokenHash     String   @map("token_hash")
  salt          String
  createdAt     DateTime @default(now()) @map("created_at")
  revokedAt     DateTime? @map("revoked_at")
  rotatedFromId String?  @map("rotated_from_id")

  @@map("integration_tokens")
}

model DemoRun {
  id              String         @id
  productKey      String         @map("product_key")
  suiteType       String         @map("suite_type")
  mode            String
  state           String
  progressMessage String         @map("progress_message")
  executionId     String?        @unique @map("execution_id")
  execution       TestExecution? @relation(fields: [executionId], references: [id])
  errorMessage    String?        @map("error_message")
  artifactPath    String?        @map("artifact_path")
  createdAt       DateTime       @default(now()) @map("created_at")
  startedAt       DateTime?      @map("started_at")
  finishedAt      DateTime?      @map("finished_at")

  @@map("demo_runs")
}
