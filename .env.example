# Local defaults. Keep real provider-managed values and tokens outside source control.
NODE_ENV="development"
HOST="127.0.0.1"
PORT="3001"
DATABASE_URL="postgresql://qualityops:qualityops@localhost:5432/qualityops_dev"
TEST_DATABASE_URL="postgresql://qualityops:qualityops@localhost:5432/qualityops_test"
DATABASE_SSL_MODE="disable"
DATABASE_POOL_MAX="8"
PUBLIC_APP_URL="http://127.0.0.1:5173"
API_BASE_URL="http://127.0.0.1:3001"
DEMO_PIPELINE_LAB_ENABLED="true"
DEMO_RUNNER_MODE="local"
DEMO_SYSTEM_TOKEN="REPLACE_WITH_LOCAL_ONLY_PRODUCTION_TEST_SECRET"
DEMO_MAX_CONCURRENT_RUNS="2"
DEMO_RATE_LIMIT_MAX="4"
DEMO_RATE_LIMIT_WINDOW_MS="60000"
DEMO_RUN_COOLDOWN_MS="10000"
DEMO_RUN_TIMEOUT_MS="120000"
QUALITYOPS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
