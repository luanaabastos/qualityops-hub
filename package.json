{
  "name": "qualityops-hub",
  "description": "TestOps Hub centralizes automated test results, execution history, coverage and regression signals from CI pipelines.",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "volta": {
    "node": "20.20.1",
    "pnpm": "10.34.5"
  },
  "engines": {
    "node": ">=20.20.1 <21",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "node scripts/workspace-run.mjs build",
    "lint": "node scripts/workspace-run.mjs lint",
    "typecheck": "node scripts/workspace-run.mjs typecheck",
    "test": "node scripts/workspace-run.mjs test && pnpm test:ci-ingestion",
    "test:ci-ingestion": "node --test scripts/ci-ingest-report.test.mjs",
    "test:e2e": "playwright test",
    "test:hosted-preview": "playwright test --config=playwright.hosted-preview.config.ts",
    "migrate:deploy": "node apps/api/dist/migrate.js",
    "bootstrap:demo": "node apps/api/dist/bootstrap.js",
    "start": "node scripts/start-production.mjs",
    "test:production": "node apps/api/dist/migrate.js && node apps/api/dist/bootstrap.js && playwright test --config=playwright.production.config.ts",
    "integration-token:create": "pnpm --filter @qualityops-hub/api exec tsx src/token-cli.ts create",
    "integration-token:rotate": "pnpm --filter @qualityops-hub/api exec tsx src/token-cli.ts rotate",
    "integration-token:revoke": "pnpm --filter @qualityops-hub/api exec tsx src/token-cli.ts revoke",
    "evidence:capture": "node scripts/capture-evidence.mjs",
    "scan:references": "node scripts/reference-scan.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "scan:public": "node scripts/public-release-scan.mjs",
    "demo:start": "node scripts/demo-runner.mjs start",
    "demo:stop": "node scripts/demo-runner.mjs stop",
    "demo:status": "node scripts/demo-runner.mjs status",
    "demo:reset": "node scripts/demo-runner.mjs reset"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "cypress": "15.20.1",
    "globals": "^17.9.0",
    "mochawesome": "7.1.4",
    "typescript": "5.9.3"
  }
}
