{
  "name": "qualityops-hub",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "volta": {
    "node": "20.20.1",
    "pnpm": "10.34.5"
  },
  "engines": {
    "node": ">=20.20.1 <21",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "node scripts/workspace-run.mjs build",
    "lint": "node scripts/workspace-run.mjs lint",
    "typecheck": "node scripts/workspace-run.mjs typecheck",
    "test": "node scripts/workspace-run.mjs test",
    "test:e2e": "playwright test",
    "integration-token:create": "pnpm --filter @qualityops-hub/api exec tsx src/token-cli.ts create",
    "integration-token:rotate": "pnpm --filter @qualityops-hub/api exec tsx src/token-cli.ts rotate",
    "integration-token:revoke": "pnpm --filter @qualityops-hub/api exec tsx src/token-cli.ts revoke",
    "evidence:capture": "node scripts/capture-evidence.mjs",
    "scan:references": "node scripts/reference-scan.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "demo:start": "node scripts/demo-runner.mjs start",
    "demo:stop": "node scripts/demo-runner.mjs stop",
    "demo:status": "node scripts/demo-runner.mjs status"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "cypress": "15.20.1",
    "globals": "^17.9.0",
    "mochawesome": "7.1.4",
    "typescript": "5.9.3"
  }
}
